# Source this before running the orchestrator on the GPU node:  source /home/cc/Run-time-Manager/deploy/gpu-node/gpu-node.env
# Consolidated node: the milestone-II tree is vendored in-repo under network/, not at ~/.
export NETPROMPT_ROOT="/home/cc/Run-time-Manager/network/milestone-II-latest/netprompt-milestone-II"
# Runtime reads NETPROMPT_TREE_ROOT for the P4 JSON + rule paths (same tree);
# without it config.py falls back to a stale /home/cc/Run-time-Manager-2 default.
export NETPROMPT_TREE_ROOT="$NETPROMPT_ROOT"
export NETPROMPT_LLM_MODEL="Qwen/Qwen2.5-1.5B-Instruct"
export NETPROMPT_LLM_ADAPTER="$NETPROMPT_ROOT/netprompt_qwen_kg_rag_orchestrator/final_adapter"
export NETPROMPT_LLM_DEVICE_MAP="cuda:0"
export NETPROMPT_LLM_USE_4BIT="0"      # CRITICAL on P100: FP16, no bitsandbytes
export NETPROMPT_LLM_MAX_NEW_TOKENS="128"
# --- Neo4j KG: local instance on this consolidated node (bolt on localhost) ---
# Runtime (runtime/config.py reads NETPROMPT_KG_*):
export NETPROMPT_KG_URI="bolt://localhost:7687"
export NETPROMPT_KG_USER="neo4j"
export NETPROMPT_KG_PASS="netprompt123"
# Orchestrator / milestone-II code reads NEO4J_*:
export NEO4J_URI="bolt://localhost:7687"
export NEO4J_USER="neo4j"
export NEO4J_PASSWORD="netprompt123"
# --- Tier-2 regen serving (M7): pinned Qwen-Coder on the 2nd GPU. The pinned
#     revision makes constrained-decoding candidates reproducible (DoD #4). ---
export NETPROMPT_REGEN_MODEL="Qwen/Qwen2.5-Coder-1.5B-Instruct"
export NETPROMPT_REGEN_REVISION="2e1fd397ee46e1388853d2af2c993145b0f1098a"
export NETPROMPT_REGEN_DEVICE="cuda:1"
export NETPROMPT_REGEN_MAX_NEW_TOKENS="64"
